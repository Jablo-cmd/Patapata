# Copy to .env.local (never commit real values). Only PUBLIC values belong here:
# the Supabase project URL and the publishable/anon key. Row Level Security
# protects the data; the anon key is designed to ship inside the app.
#
# NEVER put the service-role / secret key in any EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-key-from-`npx supabase status`
# Optional: shown on the account-status screen
EXPO_PUBLIC_SUPPORT_EMAIL=
